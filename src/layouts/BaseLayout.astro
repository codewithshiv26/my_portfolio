---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Shivam | Developer & Student",
    description = "A B.Tech student documenting what I learn, the projects I build and my progress in software development.",
} = Astro.props;

const pageTitle =
    title === "Shivam | Developer & Student" ? title : `${title} | Shivam`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const socialImageURL = new URL("/banner.webp", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark light" />
        <meta name="theme-color" content="#1a1a1a" />

        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Shivam" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <script is:inline>
            try {
                const savedTheme = localStorage.getItem("theme");
                document.documentElement.dataset.theme =
                    savedTheme === "light" ? "light" : "dark";
            } catch {
                document.documentElement.dataset.theme = "dark";
            }
        </script>
        <script
            type="module"
            src="https://ascii.rest/ascii.js"
            is:inline
        ></script>
    </head>

    <body>
        <a class="skip-link" href="#main-content">
            Skip to content
        </a>
        <Header />
        <main id="main-content" class="site-shell">
            <slot />
        </main>
        <Footer />
    </body>
</html>
